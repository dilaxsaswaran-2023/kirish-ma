# Values for the VM's ignored .env.production, not web/mobile env files.
MQTT_BROKER_URL=ssl://mqtt.sathurix.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ALLOW_ANONYMOUS=true
MQTT_REQUIRE_TLS=true
MQTT_CLIENT_ID=kirish-backend-vm
MQTT_TOPIC_PREFIX=kirish
# Blank credentials match the supplied screenshot. Do not connect physical motors
# until the broker administrator enables per-device accounts/topic authorization.
